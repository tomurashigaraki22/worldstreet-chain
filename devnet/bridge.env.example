# Copy these values into the VPS environment only after deploying and auditing the Sepolia bridge contract.
WSC_ETHEREUM_NETWORK=sepolia
WSC_ETHEREUM_RPC_URL=https://sepolia.example.invalid
WSC_ETHEREUM_BRIDGE_CONTRACT=0x0000000000000000000000000000000000000000
# keccak256("Deposit(bytes32,address,uint256,string)") topic for the deployed contract event.
WSC_ETHEREUM_DEPOSIT_TOPIC=0x
WSC_ETHEREUM_CONFIRMATIONS=12

# Circle testnet USDC on Ethereum Sepolia. The bridge contract is intentionally
# blank until the capped, reserve-gated USDC->MNA settlement contract is deployed.
WSC_ETHEREUM_USDC_TOKEN=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
WSC_ETHEREUM_USDC_BRIDGE_CONTRACT=
WSC_ETHEREUM_USDC_DEPOSIT_TOPIC=
WSC_USDC_ASSET_ID=ethereum:USDC:sepolia:0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
WSC_USDC_MNA_RATE_MNA_PER_USDC=
WSC_MNA_BRIDGE_ENABLED=false
WSC_MNA_RESERVE_USDC_MICRO=0
WSC_MNA_FLOOR_USDC_MICRO_PER_MNA=0
WSC_MNA_ISSUANCE_CAP_MICRO=0

# Solana WSOL is deferred until SOL liquidity is funded. Keep it disabled for now.
WSC_SOLANA_NETWORK=devnet
WSC_SOLANA_RPC_URL=https://api.devnet.solana.com
WSC_SOLANA_MODE=disabled
WSC_SOLANA_BRIDGE_PROGRAM=
WSC_SOLANA_PROGRAM_ID=
WSC_SOLANA_STATE_ADDRESS=
WSC_SOLANA_PROGRAM_AUTHORITY_KEYPAIR=/root/.config/solana/intertrain-devnet-deployer.json
WSC_SOLANA_CLIENT_BIN=/usr/local/bin/intertrain-wsol-client
WSC_SOLANA_VAULT_ADDRESS=
WSC_SOLANA_VAULT_KEYPAIR=/root/.config/solana/intertrain-wsol-vault.json
WSC_SOLANA_WSOL_MINT=So11111111111111111111111111111111111111112
WSC_SOLANA_SPL_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
WSC_SOLANA_SPL_USDC_VAULT_TOKEN_ACCOUNT=
WSC_SOLANA_COMMITMENT=finalized
WSC_SOLANA_CONFIRMATIONS=32

# Shared secret for the relayer -> Intertrain bridge RPC. Keep this out of git.
WSC_BRIDGE_OPERATOR_TOKEN=
WSC_WETH_ASSET_ID=ethereum:WETH:sepolia:YOUR_DEPLOYED_CONTRACT
# Set this after running ops/setup-wsol-vault.sh; it is derived from the vault and canonical mint.
WSC_WSOL_ASSET_ID=solana:WSOL:devnet:vault:YOUR_VAULT_ADDRESS:So11111111111111111111111111111111111111112
