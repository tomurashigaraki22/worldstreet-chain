# Copy to /etc/worldstreet/relayer.env, chmod 600, and fill only after
# deploying and reviewing the Sepolia contract. Never commit this file.
WSC_ETHEREUM_NETWORK=sepolia
WSC_ETHEREUM_RPC_URL=https://your-sepolia-rpc-url
WSC_ETHEREUM_BRIDGE_CONTRACT=0xYOUR_DEPLOYED_CONTRACT
WSC_ETHEREUM_DEPOSIT_TOPIC=0xYOUR_DEPOSIT_EVENT_TOPIC
WSC_ETHEREUM_CONFIRMATIONS=12
WSC_WETH_ASSET_ID=ethereum:WETH:sepolia:YOUR_DEPLOYED_CONTRACT
WSC_RPC_URL=http://127.0.0.1:26657/rpc
WSC_BRIDGE_OPERATOR_TOKEN=generate-a-long-random-token
WSC_RELAYER_ACCOUNT=intertrain-sepolia-deployer
WSC_KEYSTORE_DIR=/root/.foundry/keystores
# Store the keystore password in a separate root-only file, not here.
WSC_KEYSTORE_PASSWORD_FILE=/etc/worldstreet/relayer-password
WSC_RELAYER_STATE=/var/lib/worldstreet-relayer/state.sqlite3
WSC_RELAYER_HEALTH=/var/lib/worldstreet-relayer/health.json
WSC_RELAYER_POLL_SECONDS=10
