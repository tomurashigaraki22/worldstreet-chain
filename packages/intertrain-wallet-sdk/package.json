{
  "name": "@watchupltd/intertrain-wallet-sdk",
  "version": "0.1.1-devnet",
  "private": false,
  "files": [
    "dist"
  ],
  "description": "Browser wallet SDK for the Intertrain devnet",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.7.2",
    "@scure/base": "^1.2.4",
    "@scure/bip39": "^1.5.4"
  },
  "peerDependencies": {
    "@solana/web3.js": ">=1.98.0",
    "@solana/spl-token": ">=0.4.0"
  },
  "peerDependenciesMeta": {
    "@solana/web3.js": {
      "optional": true
    },
    "@solana/spl-token": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
